# Copy to .env and supply real environment values. Never commit .env.
# This template does not configure a usable database or directory.
DB_SERVER=127.0.0.1
DB_DATABASE=AssetMaintDB
DB_PORT=1433
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=http://localhost:3001
# Keep background side effects disabled until target/providers are verified.
JOBS_ENABLED=false
JOB_SNIPE_SYNC_ENABLED=false
JOB_EVIDENCE_IMPORT_ENABLED=false
MS_GRAPH_ENABLED=false
# LDAP is optional. Leave all eight values empty for local-only login.
# To enable LDAP, supply all eight values; partial configuration fails startup.
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_USER_SEARCH_FILTER=
LDAP_GROUP_SEARCH_BASE=
LDAP_GROUP_SUPERADMIN=
# Set these to prepared paths on the chosen host/container before evidence use.
# EVIDENCE_STORAGE_ROOT=/absolute/path/to/evidence
# EVIDENCE_STORAGE_HOST_PATH=/absolute/path/to/evidence
# FIREBASE_SERVICE_ACCOUNT_HOST_PATH=/absolute/path/to/service-account.json
